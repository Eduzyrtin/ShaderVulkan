<?xml version="1.0" encoding="utf-8"?>
<!--
ShaderVulkan - Manifest para overlay CRT tipo monitor RetroArch
Overlay funcional sobre ABSOLUTAMENTE TODO el sistema con selector de shaders desplegable
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- T96: sin permiso de internet, sin almacenamiento (los shaders se leen con el selector de carpetas del sistema) y sin
         SYSTEM_ALERT_WINDOW (las ventanas van como overlay del servicio de accesibilidad): menos que declarar en Play Console -->

    <!-- Captura de pantalla y servicios en primer plano -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <!-- Modo Glass: servicio en primer plano sin proyección de pantalla -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Vulkan feature requirements -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false"
        android:minSdkVersion="1.1"/>

    <!-- T62: ver los iconos y nombres de las apps con icono de lanzador (visibilidad de paquetes, Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.ShaderVulkan"
        tools:targetApi="tiramisu">

        <!-- Activity principal - Overlay CRT tipo monitor RetroArch -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <!-- Modo overlay real sobre ABSOLUTAMENTE TODO el sistema -->
            <meta-data
                android:name="android.window.isFloatingWindow"
                android:value="true"/>

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- T72: atajos de la pulsación larga sobre el icono -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Recupera la captura cuando el sistema corta la proyección (bloqueo de pantalla): transparente, sin historial -->
        <activity
            android:name=".ProjectionRecoveryActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Arranca la sesión de un perfil por app (T61): transparente, pide el permiso de captura o arranca Glass -->
        <activity
            android:name=".AutoStartActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Arranque rápido del último shader (T70 azulejo, T72 atajo): transparente, sin historial -->
        <activity
            android:name=".QuickStartActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Apps automáticas (T62) -->
        <activity android:name=".AppProfilesActivity"
            android:label="@string/apps_title" />

        <!-- Ajustes de la app (T60): color de la interfaz y comportamiento -->
        <activity android:name=".AppSettingsActivity"
            android:label="@string/btn_settings" />

        <activity android:name=".ShaderSettingsActivity"
            android:label="@string/btn_parameters" />

        <!-- Servicio de captura y proceso de shaders -->
        <service
            android:name=".services.ShaderCaptureService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="@string/notif_glass_special_use" />
        </service>

        <!-- Azulejo de ajustes rápidos (T70) -->
        <service
            android:name=".services.ShaderTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Servicio de accesibilidad para el overlay de shaders -->
        <service
            android:name=".services.ShaderOverlayAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false"
            android:label="ShaderVulkan Overlay Service">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Guarda el idioma elegido en AJUSTES también en Android 12 y anteriores (AppCompat) -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

</manifest>
