<?xml version="1.0" encoding="utf-8"?>
<!--
    Acción principal (RUN / RESUME): barra de fósforo casi amarillo con tinta oscura, como la línea de estado de la manpage
    de referencia, con 2 dp de halo alrededor. Con foco el halo crece.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/crtInk40">
    <item>
        <selector>
            <item android:state_enabled="false">
                <layer-list>
                    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                        <shape android:shape="rectangle">
                            <solid android:color="?attr/crtFaint" />
                            <corners android:radius="@dimen/crt_corner" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <!-- Foco (mando): anillo encendido separado de la barra, visible sobre el fondo oscuro aunque la barra ya brille -->
            <item android:state_focused="true">
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <stroke android:width="2dp" android:color="?attr/crtHot" />
                            <corners android:radius="4dp" />
                        </shape>
                    </item>
                    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
                        <shape android:shape="rectangle">
                            <solid android:color="?attr/crtHot" />
                            <corners android:radius="@dimen/crt_corner" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item>
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="?attr/crtHot1A" />
                            <corners android:radius="4dp" />
                        </shape>
                    </item>
                    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                        <shape android:shape="rectangle">
                            <solid android:color="?attr/crtHot40" />
                            <corners android:radius="3dp" />
                        </shape>
                    </item>
                    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                        <shape android:shape="rectangle">
                            <solid android:color="?attr/crtHot" />
                            <corners android:radius="@dimen/crt_corner" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/crt_corner" />
        </shape>
    </item>
</ripple>
