<?xml version="1.0" encoding="utf-8"?>
<!-- Opción de una lista desplegable: barra resaltada con foco (mando), ripple al tocar -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/crtGhostStrong">
    <item>
        <selector>
            <item android:state_focused="true">
                <color android:color="?attr/crtGhostStrong" />
            </item>
            <item android:state_checked="true">
                <color android:color="?attr/crtGhost" />
            </item>
            <item>
                <color android:color="@android:color/transparent" />
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <color android:color="#FFFFFFFF" />
    </item>
</ripple>
