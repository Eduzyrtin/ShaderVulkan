<?xml version="1.0" encoding="utf-8"?>
<!-- Selector desplegable: caja de fósforo tenue con la flecha a píxeles a la derecha; con foco se enciende el filo -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/crtGhostStrong">
    <item>
        <selector>
            <item android:state_focused="true">
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="?attr/crtGhostStrong" />
                            <stroke android:width="@dimen/crt_stroke" android:color="?attr/crtHot" />
                            <corners android:radius="@dimen/crt_corner" />
                        </shape>
                    </item>
                    <item android:drawable="@drawable/ic_crt_arrow_down" android:gravity="end|center_vertical"
                        android:end="12dp" android:width="14dp" android:height="8dp" />
                </layer-list>
            </item>
            <item>
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="?attr/crtPhosphor0F" />
                            <stroke android:width="@dimen/crt_stroke" android:color="?attr/crtFaint" />
                            <corners android:radius="@dimen/crt_corner" />
                        </shape>
                    </item>
                    <item android:drawable="@drawable/ic_crt_arrow_down" android:gravity="end|center_vertical"
                        android:end="12dp" android:width="14dp" android:height="8dp" />
                </layer-list>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/crt_corner" />
        </shape>
    </item>
</ripple>
