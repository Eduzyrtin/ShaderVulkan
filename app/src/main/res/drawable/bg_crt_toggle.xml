<?xml version="1.0" encoding="utf-8"?>
<!--
    Interruptor (barras por lado, detección, LOCK): apagado es un botón normal; encendido (isSelected) es una barra de
    fósforo como la acción principal, más pequeña.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/crtGhostStrong">
    <item>
        <selector>
            <item android:state_selected="true" android:state_focused="true">
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <stroke android:width="2dp" android:color="?attr/crtHot" />
                            <corners android:radius="3dp" />
                        </shape>
                    </item>
                    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
                        <shape android:shape="rectangle">
                            <solid android:color="?attr/crtHot" />
                            <corners android:radius="@dimen/crt_corner" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item android:state_selected="true">
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <solid android:color="?attr/crtHot33" />
                            <corners android:radius="3dp" />
                        </shape>
                    </item>
                    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                        <shape android:shape="rectangle">
                            <solid android:color="?attr/crtPhosphor" />
                            <corners android:radius="@dimen/crt_corner" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item android:state_focused="true">
                <layer-list>
                    <item>
                        <shape android:shape="rectangle">
                            <stroke android:width="1dp" android:color="?attr/crtHot59" />
                            <corners android:radius="3dp" />
                        </shape>
                    </item>
                    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                        <shape android:shape="rectangle">
                            <solid android:color="?attr/crtGhostStrong" />
                            <stroke android:width="@dimen/crt_stroke" android:color="?attr/crtHot" />
                            <corners android:radius="@dimen/crt_corner" />
                        </shape>
                    </item>
                </layer-list>
            </item>
            <item>
                <layer-list>
                    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                        <shape android:shape="rectangle">
                            <solid android:color="?attr/crtPhosphor0F" />
                            <stroke android:width="@dimen/crt_stroke" android:color="?attr/crtFaint" />
                            <corners android:radius="@dimen/crt_corner" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/crt_corner" />
        </shape>
    </item>
</ripple>
