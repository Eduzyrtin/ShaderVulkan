<?xml version="1.0" encoding="utf-8"?>
<!-- Parámetro editable: nombre y valor en una línea, slider debajo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/crt_space_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txt_param_fav"
            style="@style/CrtText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="40dp"
            android:paddingStart="0dp"
            android:paddingEnd="@dimen/crt_space_s"
            android:text="@string/param_fav_off" />

        <TextView
            android:id="@+id/txt_param_name"
            style="@style/CrtText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            tools:text="Parameter Name" />

        <TextView
            android:id="@+id/txt_param_value"
            style="@style/CrtText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/crt_space_m"
            android:gravity="end"
            android:minWidth="56dp"
            android:shadowColor="?attr/crtGlowHot"
            tools:text="0.00"
            android:textColor="?attr/crtHot" />

        <TextView
            android:id="@+id/txt_param_reset"
            style="@style/CrtText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/crt_space_s"
            android:gravity="center"
            android:minWidth="40dp"
            android:text="@string/param_reset" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_param"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="1" />

</LinearLayout>
