<?xml version="1.0" encoding="utf-8"?>
<!-- Ajustes del preset activo: perfiles arriba, parámetros en medio y acciones abajo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/crt_background"
    android:foreground="@drawable/bmp_scanlines"
    android:orientation="vertical">

    <!-- Cabecera -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_crt_header"
        android:orientation="vertical"
        android:paddingBottom="@dimen/crt_space_m">

        <TextView
            style="@style/CrtText.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/shader_config_title" />

        <TextView
            android:id="@+id/txt_settings_shader"
            style="@style/CrtText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Perfiles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/crt_space_m"
        android:background="@drawable/bg_crt_panel"
        android:orientation="vertical"
        android:padding="@dimen/crt_space_m">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/CrtText.Label"
                android:layout_width="@dimen/crt_label_column"
                android:layout_height="wrap_content"
                android:text="@string/label_profile" />

            <Spinner
                android:id="@+id/spinner_profiles"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/crt_space_s"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_save_profile"
                style="@style/CrtButton.Small"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/cd_save_profile"
                android:text="@string/btn_save" />

            <Button
                android:id="@+id/btn_rename_profile"
                style="@style/CrtButton.Small"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/crt_space_s"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/btn_rename" />

            <Button
                android:id="@+id/btn_export_preset"
                style="@style/CrtButton.Small"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/crt_space_s"
                android:layout_weight="1"
                android:contentDescription="@string/cd_export_preset"
                android:text="@string/btn_export" />

            <Button
                android:id="@+id/btn_delete_profile"
                style="@style/CrtButton.Alert"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/crt_space_s"
                android:layout_weight="1"
                android:contentDescription="@string/cd_delete_profile"
                android:minHeight="@dimen/crt_touch_compact"
                android:paddingStart="@dimen/crt_space_m"
                android:paddingEnd="@dimen/crt_space_m"
                android:text="@string/btn_delete"
                android:textSize="@dimen/crt_text_label" />
        </LinearLayout>
    </LinearLayout>

    <!-- Parámetros -->
    <TextView
        style="@style/CrtText.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/crt_space_l"
        android:text="@string/label_parameters" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_parameters"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/crt_space_s"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbars="vertical" />

    <!-- Acciones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/crt_space_m"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_reset_parameters"
            style="@style/CrtButton.Alert"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_format_all" />

        <Button
            android:id="@+id/btn_close_settings"
            style="@style/CrtButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/crt_space_s"
            android:layout_weight="1"
            android:text="@string/btn_return" />
    </LinearLayout>

</LinearLayout>
