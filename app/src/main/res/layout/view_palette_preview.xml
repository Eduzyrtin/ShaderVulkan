<?xml version="1.0" encoding="utf-8"?>
<!--
    Vista previa de una paleta: se infla con un contexto que lleva la paleta candidata (CrtTheme.previewContext), así que enseña la
    interfaz real (estilos y atributos de verdad) con esos colores sin tocar la pantalla de detrás. No es interactiva.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/crt_background"
    android:foreground="@drawable/bmp_scanlines"
    android:importantForAccessibility="no"
    android:orientation="vertical"
    android:padding="@dimen/crt_space_m">

    <TextView
        style="@style/CrtText.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/preview_title" />

    <TextView
        style="@style/CrtText.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/preview_item_info" />

    <TextView
        style="@style/CrtText.Status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/crt_space_s"
        android:text="@string/preview_active_module" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/crt_space_m"
        android:orientation="horizontal">

        <Button
            style="@style/CrtButton.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="false"
            android:text="@string/preview_params" />

        <Button
            style="@style/CrtButton.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/crt_space_s"
            android:layout_weight="1"
            android:focusable="false"
            android:minHeight="@dimen/crt_touch_compact"
            android:text="@string/preview_run" />

        <Button
            style="@style/CrtButton.Alert"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/crt_space_s"
            android:layout_weight="1"
            android:focusable="false"
            android:minHeight="@dimen/crt_touch_compact"
            android:text="@string/preview_stop" />
    </LinearLayout>

    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/crt_progress_height"
        android:layout_marginTop="@dimen/crt_space_m"
        android:max="100"
        android:progress="64"
        android:progressDrawable="@drawable/crt_progress" />

    <TextView
        style="@style/CrtText.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/crt_space_s"
        android:shadowColor="?attr/crtGlowWarn"
        android:text="@string/preview_warning"
        android:textColor="?attr/crtWarn" />
</LinearLayout>
